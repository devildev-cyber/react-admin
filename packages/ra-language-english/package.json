{
  "name": "ra-language-english",
  "version": "5.8.0",
  "description": "English messages for react-admin, the frontend framework for building admin applications on top of REST/GraphQL services",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/@rocketBee/react-admin.git"
  },
  "files": [
    "*.md",
    "dist",
    "src"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "scripts": {
    "build": "node api.js && yarn run build-cjs && yarn run build-esm",
    "build-cjs": "node api.js && rimraf ./dist/cjs && tsc --outDir dist/cjs",
    "build-esm": "node api.js && rimraf ./dist/esm && tsc --outDir dist/esm --module es2015",
    "watch": "tsc --outDir dist/esm --module es2015 --watch"
  },
  "dependencies": {
    "ra-core": "^5.8.0"
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "typescript": "^5.1.3"
  },
  "keywords": [
    "react",
    "react-admin",
    "admin-on-rest",
    "translation"
  ],
  "author": "Fran\u00e7ois Zaninotto",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/@rocketBee/react-admin/issues"
  },
  "homepage": "https://github.com/@rocketBee/react-admin#readme",
  "gitHead": "587df4c27bfcec4a756df4f95e5fc14728dfc0d7"
}
